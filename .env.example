# Local configuration for chora-delivery.
# Copy to .env and fill in values. Never commit .env or secrets.

CHORA_ENV=local
PORT=8080
CHORA_GRPC_PORT=9090

# Database (PostgreSQL). CHORA_DB_DSN is the runtime DSN (app_rw role).
# CHORA_OUTBOX_DSN defaults to the same database when omitted.
POSTGRES_DB=chora_delivery
POSTGRES_USER=chora
POSTGRES_PASSWORD=chora
POSTGRES_PORT=5432
CHORA_DB_DSN=postgres://chora:chora@postgres:5432/chora_delivery?sslmode=disable
CHORA_OUTBOX_DSN=postgres://chora:chora@postgres:5432/chora_delivery?sslmode=disable
CHORA_OUTBOX_WORKER_ID=chora-delivery-local

# Event bus — NATS JetStream (chora-common/eventbus). Unset disables the bus
# (in-memory fallback; not durable).
NATS_URL=nats://nats:4222
CHORA_SOURCE_PROJECT=chora-local
CHORA_SOURCE_SERVICE=chora-delivery

# Object storage — S3-compatible (MinIO locally). Used by the course-media
# signer; COURSE_MEDIA_BUCKET empty leaves the upload-url route 503ing.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=chora
S3_SECRET_ACCESS_KEY=chora
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
COURSE_MEDIA_BUCKET=media

# Tracing — OTLP/gRPC endpoint (the OTel Collector). Unset falls back to stdout.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Downstream clients.
SVC_CREATION_GRPC_URL=creation:9090
SVC_IDENTITY_HTTP_URL=http://identity:8080
CHORA_PAYMENTS_GRPC_ADDR=payments:9090

# Optional local Redis (realtime fan-out). Unset uses the in-process fallback.
CHORA_REDIS_ADDR=redis:6379

# Local event-push receivers: optional bearer-token audience/allowlist. When
# both are empty the receivers run without token verification (mesh/network is
# expected to restrict /api/internal/*).
# CHORA_PUBSUB_PUSH_AUDIENCE=https://delivery.example/api/internal/pubsub/identity-profile-inbox
# CHORA_PUBSUB_PUSH_TRUSTED_SA=
